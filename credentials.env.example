# Copy to ~/.aily_connector/credentials.env and fill with your own browser session.
# Do not commit the real file.
#
# AILY_CONNECTOR_COOKIE is the Cookie header value for https://aily.feishu.cn.
# AILY_CONNECTOR_CSRF is usually the value of the lgw_csrf_token cookie.
AILY_CONNECTOR_CSRF=
AILY_CONNECTOR_COOKIE=
